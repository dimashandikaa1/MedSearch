# Salin file ini menjadi .env.local lalu isi API key dari https://aistudio.google.com/apikey
GEMINI_API_KEY=isi_api_key_kamu_di_sini

# Opsional: ganti model bila model default sudah tidak tersedia
GEMINI_MODEL=gemini-3.5-flash-lite

# Opsional: model cadangan bila model utama sedang penuh (pisahkan dengan koma)
# GEMINI_MODEL_CADANGAN=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-flash-latest
